# Safe default: no Java agent until the exact adapter fingerprint exists.
APOLLO_NATIVE_ASSIST=off

APOLLO_NATIVE_HOST_DIR=__RESOLVE_ON_GAMENODE__
APOLLO_SERVER_HOST_DIR=__RESOLVE_ON_GAMENODE__
# Existing Workshop cache nested under the server tree. This is the only
# writable exception below the otherwise read-only server root.
APOLLO_WORKSHOP_HOST_DIR=__RESOLVE_ON_GAMENODE__
APOLLO_SERVER_ROOT=__RESOLVE_IN_EXISTING_CONTAINER__
APOLLO_SERVER_JAR_RELATIVE=__RESOLVE_FROM_EXISTING_RUNTIME__

# The 2026-08-09 capture found no active runtime lock in this container.
APOLLO_RUNTIME_LOCK_MODE=none-captured

# Trusted shell bootstrap. Compose unsets BASH_ENV/ENV/BASHOPTS/SHELLOPTS plus
# the only function name that could shadow the `builtin` purge itself, then
# launches /bin/bash --noprofile --norc, then the wrapper purges imported functions
# with builtins before any external command. The pinned env binary is then used
# for NUL-safe raw BASH_FUNC enumeration and final per-name removal. Reconfirm
# kind/mode/hash in Task A8.
APOLLO_BOOTSTRAP_ENV_PATH=/usr/bin/env
APOLLO_BOOTSTRAP_ENV_KIND=file
APOLLO_BOOTSTRAP_ENV_MODE=__CAPTURE_NUMERIC_MODE__
APOLLO_BOOTSTRAP_ENV_SHA256=__CAPTURE_AT_TASK_A8__
APOLLO_BOOTSTRAP_BASH_PATH=/bin/bash
APOLLO_BOOTSTRAP_BASH_KIND=file
APOLLO_BOOTSTRAP_BASH_MODE=__CAPTURE_NUMERIC_MODE__
APOLLO_BOOTSTRAP_BASH_SHA256=__CAPTURE_AT_TASK_A8__

# Exact image ENTRYPOINT count-frame. These are launcher facts, not fingerprint values.
APOLLO_ORIGINAL_ENTRYPOINT_COUNT=2
APOLLO_ORIGINAL_ENTRYPOINT_0_PATH=/bin/bash
APOLLO_ORIGINAL_ENTRYPOINT_0_KIND=file
APOLLO_ORIGINAL_ENTRYPOINT_0_MODE=__CAPTURE_NUMERIC_MODE__
APOLLO_ORIGINAL_ENTRYPOINT_0_SHA256=__CAPTURE_AT_TASK_A8__
APOLLO_ORIGINAL_ENTRYPOINT_1_PATH=/home/steam/run_server.sh
APOLLO_ORIGINAL_ENTRYPOINT_1_KIND=file
APOLLO_ORIGINAL_ENTRYPOINT_1_MODE=__CAPTURE_NUMERIC_MODE__
APOLLO_ORIGINAL_ENTRYPOINT_1_SHA256=__CAPTURE_AT_TASK_A8__

# Full-file transport hash; fingerprintSha256 inside the file has a separate canonical derivation.
APOLLO_FINGERPRINT_FILE_SHA256=__CAPTURE_AT_TASK_A7__
